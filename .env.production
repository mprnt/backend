# Production Environment Variables
# Set these in Railway dashboard

# API Configuration
PORT=3000
NODE_ENV=production
API_VERSION=v1

# Database
DATABASE_URL=postgresql://user:password@host:5432/mprnt

# Razorpay
RAZORPAY_KEY_ID=your_production_key_id
RAZORPAY_KEY_SECRET=your_production_secret

# Redis (for Bull queue)
REDIS_URL=redis://host:6379

# AWS S3 (for document storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_S3_BUCKET=mprnt-docs

# WebSocket
WEBSOCKET_PORT=3000
WEBSOCKET_PATH=/api/v1/ws

# CORS
CORS_ORIGIN=https://your-frontend.vercel.app

# Logging
LOG_LEVEL=info

# Session
SESSION_EXPIRY_HOURS=24

# Payment
PAYMENT_TIMEOUT_SECONDS=600

# Printer
PRINTER_HEARTBEAT_TIMEOUT_MINUTES=5
PRINTER_OFFLINE_THRESHOLD_MINUTES=5

# ===== Raspberry Pi / Printer integration =====
# Shared secret a Pi presents ONCE to enroll and receive its own API key.
# Generate with: openssl rand -base64 48
PRINTER_PROVISIONING_TOKEN=
# How long a printer may hold a claimed job before it is requeued (seconds)
PRINTER_JOB_LEASE_SECONDS=900
# Lifetime of the pre-signed S3 download URL handed to the Pi (seconds)
PRINTER_DOCUMENT_URL_TTL_SECONDS=900
# No heartbeat for this long marks the printer offline (seconds)
PRINTER_HEARTBEAT_TIMEOUT_SECONDS=180
