# Raspberry Pi Printer Client Configuration

# Backend API Configuration
API_BASE_URL=http://localhost:3000/api/v1

# Printer Identification
PRINTER_ID=PI_LIBFLOOR_01
KIOSK_ID=KIOSK001
PRINTER_NAME=Library Ground Floor Printer
PRINTER_IP=192.168.1.100

# Printer Capabilities
SUPPORTS_COLOR=true
SUPPORTS_DOUBLE_SIDED=true
MAX_COPIES=100
SUPPORTED_PAPER_SIZES=a4,letter

# CUPS Printer Configuration
# Find your printer name with: lpstat -p -d
CUPS_PRINTER_NAME=Brother_HL_L2350DW

# Polling Intervals (in seconds)
HEARTBEAT_INTERVAL=30
JOB_POLL_INTERVAL=5
STATUS_UPDATE_INTERVAL=2

# File & Logging
TEMP_DIR=/tmp/mprnt
LOG_FILE=/var/log/mprnt_printer.log

# Timeouts & Retries
REQUEST_TIMEOUT=10
PRINT_TIMEOUT=600
MAX_RETRIES=3
RETRY_DELAY=5

# Debug Mode
DEBUG=false
