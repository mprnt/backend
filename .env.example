# Application Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://mprnt_user:mprnt_password@localhost:5432/mprnt
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mprnt
DB_USER=mprnt_user
DB_PASSWORD=mprnt_password
DB_POOL_MIN=2
DB_POOL_MAX=20

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_TIMEOUT_MINUTES=15

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# File Storage (AWS S3 / MinIO)
STORAGE_TYPE=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=mprnt-documents
S3_ENDPOINT=
# For MinIO self-hosted alternative:
# S3_ENDPOINT=http://localhost:9000

# File Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=application/pdf,image/png,image/jpeg
UPLOAD_PATH=/tmp/uploads

# Payment Gateway (Razorpay)
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Production requires an rzp_live_ key. Set this to true to run production on an
# rzp_test_ key while testing; remove it at launch.
ALLOW_TEST_PAYMENTS=false

# Pricing lives in the database (price_lists), set per shop from the admin
# dashboard. There are no pricing environment variables.

# WebSocket Configuration
WS_PORT=3001
WS_PATH=/api/v1/ws

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7

# Monitoring & Error Tracking
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=mprnt-backend

# Admin Dashboard
ADMIN_EMAIL=admin@mprnt.com
ADMIN_DEFAULT_PASSWORD=change_this_password

# Raspberry Pi Configuration
PI_HEARTBEAT_INTERVAL_MS=30000
PI_JOB_POLL_INTERVAL_MS=5000
PI_MAX_RETRY_ATTEMPTS=3

# Document Processing
DOCUMENT_RETENTION_DAYS=30
GENERATE_THUMBNAILS=true
THUMBNAIL_QUALITY=80

# Analytics
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL_MS=60000

# Rate Limiting (Session-based)
SESSION_RATE_LIMIT_MAX=50
SESSION_RATE_LIMIT_WINDOW_MS=60000

# Health Check
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_TIMEOUT_MS=5000

# Feature Flags
ENABLE_WEBSOCKETS=true
ENABLE_ANALYTICS_EVENTS=true
ENABLE_FILE_VIRUS_SCAN=false

# Development
DEBUG=false
PRETTY_LOGS=true

# ===== Raspberry Pi / Printer integration =====
# Shared secret a Pi presents ONCE to enroll and receive its own API key.
# Generate with: openssl rand -base64 48
PRINTER_PROVISIONING_TOKEN=
# How long a printer may hold a claimed job before it is requeued (seconds)
PRINTER_JOB_LEASE_SECONDS=900
# Lifetime of the pre-signed S3 download URL handed to the Pi (seconds)
PRINTER_DOCUMENT_URL_TTL_SECONDS=900
# No heartbeat for this long marks the printer offline (seconds)
PRINTER_HEARTBEAT_TIMEOUT_SECONDS=180

# ===== Admin dashboard relay =====
# Shared secret with mprnt-admin (its MPRNT_PROXY_SECRET). Lets the dashboard
# relay each admin's real IP, so rate limits and the audit log see the admin
# rather than the dashboard server. Generate with: openssl rand -base64 48
ADMIN_PROXY_SECRET=

# ===== Dashboard thresholds (defaults shown) =====
INACTIVE_SHOP_DAYS=3
REFUND_CANDIDATE_MINUTES=60
PRINTER_OFFLINE_WARN_MINUTES=15
